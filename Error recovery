import time
import os
import random

START_PERCENT = 95.29
END_PERCENT = 99.99
DOWNLOAD_TIME = 20

TOTAL_EXTRACTION_TIME = 32400   # 9 hours
TOTAL_FOLDERS = 56
CANCEL_AFTER_FOLDER = 14

spinner = ["|","/","-","\\"]
bar_length = 30

folders = [
"Images","Videos","Camera","Screenshots","Wallpapers","Downloads","Movies","Music",
"WhatsApp Images","WhatsApp Videos","WhatsApp Documents","WhatsApp Audio",
"Telegram Images","Telegram Videos","Telegram Files","Instagram Photos",
"Instagram Videos","Facebook Photos","Facebook Videos","Snapchat Media",
"Bluetooth Files","ShareIt Files","Xender Files","Documents",
"PDF Files","Word Documents","Excel Files","PowerPoint Files",
"Contacts Backup","Call Recordings","Voice Notes","Ringtones",
"System Logs","App Cache","Android Data","Android Media",
"DCIM Camera","Screen Recorder","Screen Captures","Edited Photos",
"Edited Videos","YouTube Downloads","Netflix Downloads","Prime Video Downloads",
"Gallery Backup","Cloud Backup","Google Photos Sync","Drive Files",
"Archive Files","ZIP Files","RAR Files","Temp Files",
"App Installers","Old Backups","Hidden Media","Trash Bin"
]

GREEN="\033[92m"
CYAN="\033[96m"
YELLOW="\033[93m"
RED="\033[91m"
RESET="\033[0m"

# ---------- DOWNLOAD ----------
start = time.time()

while True:

    elapsed = time.time() - start

    if elapsed > DOWNLOAD_TIME:
        percent = END_PERCENT
    else:
        percent = START_PERCENT + ((END_PERCENT-START_PERCENT)*(elapsed/DOWNLOAD_TIME))

    filled = int(bar_length * percent // 100)
    bar = "█"*filled + " "*(bar_length-filled)

    spin = spinner[int(elapsed) % len(spinner)]

    os.system("clear")

    print(CYAN+"┌────────────────────────────────────────────┐")
    print(f"│ Downloading Recovery Package {spin}")
    print(f"│ [{bar}] {percent:6.2f}%")
    print("└────────────────────────────────────────────┘"+RESET)

    if percent >= END_PERCENT:
        break

    time.sleep(1)

print(GREEN+"\nDownload Complete\n"+RESET)
time.sleep(2)

# ---------- EXTRACTION ----------
total_steps = CANCEL_AFTER_FOLDER * 100
sleep_time = TOTAL_EXTRACTION_TIME / total_steps

total_mb = 56000
downloaded = 0

for index, folder in enumerate(folders, start=1):

    if index > CANCEL_AFTER_FOLDER:
        break

    for i in range(101):

        downloaded += random.randint(20,80)
        if downloaded > total_mb:
            downloaded = total_mb

        spin = spinner[i % len(spinner)]

        os.system("clear")

        # Data transfer
        print(YELLOW+"┌────────────────────────────────────────────┐")
        print(f"│ Data transferring to device {spin}")
        print(f"│ {downloaded} MB / {total_mb} MB")
        print("└────────────────────────────────────────────┘"+RESET)

        filled = int(bar_length * i // 100)
        bar = "█"*filled + " "*(bar_length-filled)

        # Extraction
        print(GREEN+"┌────────────────────────────────────────────┐")
        print(f"│ Extracting Folder : {folder}")
        print(f"│ Folder {index} / {TOTAL_FOLDERS}")
        print(f"│ [{bar}] {i}%")
        print("└────────────────────────────────────────────┘"+RESET)

        time.sleep(sleep_time)

print(RED+"\n✖ Extraction Failed : Connection Lost\n"+RESET)
